APP_ENV=local
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_NAME=trackly
DB_USER=trackly
DB_PASSWORD=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Absoluter Pfad zur wkhtmltopdf-Binary (für den PDF-Export)
# Linux/macOS: which wkhtmltopdf  →  z.B. /usr/bin/wkhtmltopdf
# Windows:     (Get-Command wkhtmltopdf).Source  →  z.B. C:\Program Files\wkhtmltopdf\bin\wkhtmltopdf.exe
WKHTMLTOPDF_PATH=/usr/bin/wkhtmltopdf

# Feiertags-API (Feiertage-Sync im Admin-Bereich)
# Basis-URL der REST-API; Anfragen werden als
#   {HOLIDAYS_API_BASE_URL}?years={year}&states={state}
# gestellt.
# Beispiel: https://get.api-feiertage.de
HOLIDAYS_API_BASE_URL=

# Optional: Nur bundesweite Feiertage abrufen (1 oder true).
# Dann wird der states-Parameter nicht gesetzt.
HOLIDAYS_API_ALL_STATES=0

# Timeout in Sekunden für HTTP-Anfragen an die Feiertags-API (Standard: 15)
HOLIDAYS_API_TIMEOUT_SECONDS=15
